<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <IsPackable>false</IsPackable>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>

        <RootNamespace>HasFlagExtension.Analyzers</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases\AnalyzerReleases.Shipped.md"/>
        <AdditionalFiles Include="AnalyzerReleases\AnalyzerReleases.Unshipped.md"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Templates/FlagGroupAttribute.cs" LogicalName="HasFlagExtension.Generator.Templates.FlagGroupAttribute.cs"/>
        <EmbeddedResource Include="Templates/EnumNamingAttribute.cs" LogicalName="HasFlagExtension.Generator.Templates.EnumNamingAttribute.cs"/>
        <EmbeddedResource Include="Templates/ExcludeFlagAttribute.cs" LogicalName="HasFlagExtension.Generator.Templates.ExcludeFlagAttribute.cs"/>
        <EmbeddedResource Include="Templates/ExcludeFlagEnumAttribute.cs" LogicalName="HasFlagExtension.Generator.Templates.ExcludeFlagEnumAttribute.cs"/>
        <EmbeddedResource Include="Templates/FlagDisplayNameAttribute.cs" LogicalName="HasFlagExtension.Generator.Templates.FlagDisplayNameAttribute.cs"/>
        <EmbeddedResource Include="Templates/HasFlagPrefixAttribute.cs" LogicalName="HasFlagExtension.Generator.Templates.HasFlagPrefixAttribute.cs"/>
        <EmbeddedResource Include="Templates/NamingCase.cs" LogicalName="HasFlagExtension.Generator.Templates.NamingCase.cs"/>
    </ItemGroup>

</Project>
