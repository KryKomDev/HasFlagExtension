<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>

        <RootNamespace>HasFlagExtension.Generator</RootNamespace>
        <PackageId>HasFlagExtension.Generator</PackageId>

        <Authors>KryKom</Authors>
        <Company>KryKom</Company>
        <Version>2026.3</Version>
        <PackageProjectUrl>https://github.com/KryKomDev/HasFlagExtension</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>C# source generator for generating extension methods and properties for flag enums.</Description>

        <PackageReadmeFile>Package-Readme.md</PackageReadmeFile>
        <PackageIcon>Package-Icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="HasFlagExtension.Tests"/>
    </ItemGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <NoWarn>1701;1702;RS1038</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Analyzers/HasFlagExtension.Analyzers.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../CodeFixes/HasFlagExtension.CodeFixes.csproj" PrivateAssets="all" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)/**/*.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <None Include="../Analyzers/bin/$(Configuration)/netstandard2.0/HasFlagExtension.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <None Include="../CodeFixes/bin/$(Configuration)/netstandard2.0/HasFlagExtension.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="../../Assets/Package-Readme.md" Pack="true" PackagePath=""/>
        <None Include="../../Assets/Package-Icon.png"  Pack="true" PackagePath=""/>
    </ItemGroup>

    <!--  embed the attributes and naming enum so they can be generated  -->
    <ItemGroup>

        <EmbeddedResource Include="../Analyzers/Templates/FlagGroupAttribute.cs"      LogicalName="HasFlagExtension.Generator.Templates.FlagGroupAttribute.cs"/>
        <EmbeddedResource Include="../Analyzers/Templates/EnumNamingAttribute.cs"      LogicalName="HasFlagExtension.Generator.Templates.EnumNamingAttribute.cs"/>
        <EmbeddedResource Include="../Analyzers/Templates/ExcludeFlagAttribute.cs"     LogicalName="HasFlagExtension.Generator.Templates.ExcludeFlagAttribute.cs"/>
        <EmbeddedResource Include="../Analyzers/Templates/ExcludeFlagEnumAttribute.cs" LogicalName="HasFlagExtension.Generator.Templates.ExcludeFlagEnumAttribute.cs"/>
        <EmbeddedResource Include="../Analyzers/Templates/FlagDisplayNameAttribute.cs" LogicalName="HasFlagExtension.Generator.Templates.FlagDisplayNameAttribute.cs"/>
        <EmbeddedResource Include="../Analyzers/Templates/HasFlagPrefixAttribute.cs"   LogicalName="HasFlagExtension.Generator.Templates.HasFlagPrefixAttribute.cs"/>
        <EmbeddedResource Include="../Analyzers/Templates/NamingCase.cs"               LogicalName="HasFlagExtension.Generator.Templates.NamingCase.cs"/>

    </ItemGroup>

</Project>
